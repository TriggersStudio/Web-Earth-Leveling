# ============================================================================
# Web Earth Leveling - Environment Variables Template
# ============================================================================
# Copy this file to .env.local and fill in the actual values
# NEVER commit .env or .env.local to git!

# ============================================================================
# Database Configuration (Shared with Triggers-Backend-Api)
# ============================================================================
# Local PostgreSQL - shared database with Triggers ecosystem
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/triggers"

# ============================================================================
# Application Configuration
# ============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Web Earth Leveling"

# ============================================================================
# Auth Configuration
# ============================================================================
# JWT secret should match Triggers-Backend-Api for shared sessions
# AUTH_SECRET="your-secret-key-here"
